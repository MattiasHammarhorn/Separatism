[SMWeap_AKM70_AssaultRifle]
DisplayName="Zastava M70 Assault Rifle"
ShortDisplayName="Zastava M70"
CapitalizedDisplayName="ZASTAVA M70 ASSAULT RIFLE"
Description="Rifle, 7.62x39mm, AK47\n\nYugoslav derivative of the Russian AKM, featuring a longer handguard and flippable grenade sights."
DisplayInfo[0]=(DisplayName="Zastava M70B1",Description="The Zastava M70B1 is an update of the Zastava M70 Design. Shares similar weight, recoil, rate of fire and muzzle velocity as the Russian AKM. Includes attachable blade style bayonet.",WeaponSpecialAttributesText=("Attachable Bayonet", "Solid Stock"))
DisplayInfo[1]=(DisplayName="Zastava M70AB1",Description="Lightweight version of the Zastava M70B1 with a foldable stock and no bayonet.",WeaponSpecialAttributesText=("Foldable Stock","-No Bayonet"))

[SMWeap_SKSYugo_Rifle]
DisplayName="Zastava M59/66A1 Carbine"
ShortDisplayName="Zastava M59/66A1"
CapitalizedDisplayName="ZASTAVA M59/66A1 CARBINE"
Description="Carbine, 7.62x39mm, SKS\n\nYugoslav derivative of the Russian made SKS-45, featuring flippable grenade sights."
DisplayInfo[0]=(WeaponSpecialAttributesText=("Foldable Bayonet"))

[SMWeap_TTYugo_Pistol]
DisplayName="Zastava M57 Handgun"
